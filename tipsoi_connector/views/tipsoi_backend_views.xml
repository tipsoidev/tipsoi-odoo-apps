<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_tipsoi_backend_form" model="ir.ui.view">
    <field name="name">tipsoi.backend.form</field>
    <field name="model">tipsoi.backend</field>
    <field name="arch" type="xml">
      <form string="Tipsoi Backend">
        <header>
          <button name="action_test_connection" type="object" string="Test Connection"
                  class="oe_highlight" icon="fa-plug"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,ready"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="name" readonly="1"/></h1>
          </div>

          <div class="alert alert-info" role="alert" invisible="backend_type">
            Pick the mode that matches the client. A client on the Tipsoi app uses the
            HRM API for everything; a client on the Device Portal alone uses the device
            API for everything. They are never combined — that is what keeps person
            records and employee IDs from drifting apart.
          </div>

          <group>
            <group string="Connection">
              <field name="backend_type"/>
              <field name="environment"/>
              <field name="base_url" placeholder="https://test.api-inovace360.com/api/v1"/>
              <field name="company_id" groups="base.group_multi_company"/>
              <field name="active" invisible="1"/>
            </group>
            <group string="Credentials" groups="tipsoi_connector.group_tipsoi_admin">
              <field name="username"/>
              <field name="password" password="True"/>
            </group>
          </group>

          <group>
            <group string="Sync settings">
              <field name="page_size"/>
              <field name="poll_overlap_minutes"/>
              <field name="source_timezone"
                     invisible="backend_type != 'device_portal'"/>
            </group>
            <group string="Reported by Tipsoi">
              <field name="remote_organization" readonly="1"/>
              <field name="remote_has_hrm" readonly="1"
                     invisible="backend_type != 'device_portal'"/>
              <field name="tipsoi_office_id" readonly="1"
                     invisible="backend_type != 'hrm'"/>
              <field name="tipsoi_user_id" readonly="1"
                     invisible="backend_type != 'hrm'"/>
              <field name="token_expiry" readonly="1"
                     invisible="backend_type != 'hrm'"/>
            </group>
          </group>

          <div class="alert alert-warning" role="alert"
               invisible="backend_type != 'device_portal' or not source_timezone">
            Device Portal timestamps are naive wall time in the application's timezone.
            The default is Asia/Dhaka but it is environment-overridable, so confirm it
            for this deployment rather than assuming. Note also that a small number of
            devices are configured to return punch time already converted to GMT.
          </div>

          <notebook>
            <page string="Cursors" name="cursors">
              <group>
                <group>
                  <field name="last_log_sync_time" readonly="1"
                         invisible="backend_type != 'device_portal'"/>
                  <field name="last_attendance_sync" readonly="1"
                         invisible="backend_type != 'hrm'"/>
                </group>
                <group>
                  <field name="last_employee_sync" readonly="1"/>
                  <field name="last_device_sync" readonly="1"
                         invisible="backend_type != 'device_portal'"/>
                </group>
              </group>
            </page>
            <page string="Last error" name="error" invisible="not last_error">
              <field name="last_error" readonly="1" widget="text"/>
            </page>
            <page string="Sync runs" name="runs">
              <field name="sync_run_ids" readonly="1">
                <list decoration-danger="state == 'error'"
                      decoration-warning="state == 'partial'">
                  <field name="started_at"/>
                  <field name="job"/>
                  <field name="window_from" optional="hide"/>
                  <field name="window_to" optional="hide"/>
                  <field name="fetched" sum="Fetched"/>
                  <field name="created" sum="Created"/>
                  <field name="skipped" sum="Skipped"/>
                  <field name="failed" sum="Failed"/>
                  <field name="duration_seconds" widget="float_time"/>
                  <field name="state" widget="badge"
                         decoration-success="state == 'done'"
                         decoration-danger="state == 'error'"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_tipsoi_backend_list" model="ir.ui.view">
    <field name="name">tipsoi.backend.list</field>
    <field name="model">tipsoi.backend</field>
    <field name="arch" type="xml">
      <list string="Tipsoi Backends" decoration-danger="state == 'error'">
        <field name="name"/>
        <field name="backend_type"/>
        <field name="environment"/>
        <field name="base_url"/>
        <field name="company_id" groups="base.group_multi_company"/>
        <field name="state" widget="badge"
               decoration-success="state == 'ready'"
               decoration-danger="state == 'error'"/>
      </list>
    </field>
  </record>

  <record id="action_tipsoi_backend" model="ir.actions.act_window">
    <field name="name">Backends</field>
    <field name="res_model">tipsoi.backend</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Configure the Tipsoi connection</p>
      <p>One backend per client. Its type selects the whole pipeline, so choose the mode
         that matches how this client uses Tipsoi, then press Test Connection.</p>
    </field>
  </record>

</odoo>
