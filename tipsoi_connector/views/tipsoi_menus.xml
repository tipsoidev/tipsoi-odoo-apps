<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <menuitem id="menu_tipsoi_root" name="Tipsoi"
            sequence="90" groups="tipsoi_connector.group_tipsoi_user"/>

  <menuitem id="menu_tipsoi_attendance" name="Attendance"
            parent="menu_tipsoi_root" sequence="10"/>
  <menuitem id="menu_tipsoi_punch_log" name="Punch Logs"
            parent="menu_tipsoi_attendance" action="action_tipsoi_punch_log" sequence="10"/>
  <menuitem id="menu_tipsoi_unmatched_punch" name="Unmatched Punches"
            parent="menu_tipsoi_attendance" action="action_tipsoi_unmatched_punch"
            sequence="20"/>
  <!--
    One menu entry, either pipeline. The two modes keep their day rows in separate
    models on purpose: one stages what the Tipsoi app reported and writes attendance
    from it, the other derives its rows from attendance pairing already wrote. But the
    person looking for yesterday's hours should not have to know which they bought.
  -->
  <record id="action_tipsoi_daily_attendance" model="ir.actions.server">
    <field name="name">Daily Attendance</field>
    <field name="model_id" ref="model_tipsoi_backend"/>
    <field name="state">code</field>
    <field name="code">action = model.action_daily_attendance()</field>
  </record>

  <menuitem id="menu_tipsoi_day_attendance" name="Daily Attendance"
            parent="menu_tipsoi_attendance" action="action_tipsoi_daily_attendance"
            sequence="30"/>

  <menuitem id="menu_tipsoi_devices" name="Devices"
            parent="menu_tipsoi_root" sequence="20"/>
  <menuitem id="menu_tipsoi_device" name="Devices"
            parent="menu_tipsoi_devices" action="action_tipsoi_device" sequence="10"/>
  <menuitem id="menu_tipsoi_allocation" name="Allocate / Revoke"
            parent="menu_tipsoi_devices" action="action_tipsoi_allocation" sequence="20"/>

  <menuitem id="menu_tipsoi_operations" name="Operations"
            parent="menu_tipsoi_root" sequence="30"/>
  <menuitem id="menu_tipsoi_sync_runs" name="Sync Runs"
            parent="menu_tipsoi_operations" action="action_tipsoi_sync_run" sequence="10"/>
  <menuitem id="menu_tipsoi_manual_sync" name="Manual Sync"
            parent="menu_tipsoi_operations" action="action_tipsoi_manual_sync"
            sequence="20"/>

  <menuitem id="menu_tipsoi_config" name="Configuration"
            parent="menu_tipsoi_root" sequence="90"
            groups="tipsoi_connector.group_tipsoi_admin"/>
  <menuitem id="menu_tipsoi_backend" name="Backends"
            parent="menu_tipsoi_config" action="action_tipsoi_backend" sequence="10"/>
</odoo>
