<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

  <record id="module_category_tipsoi" model="ir.module.category">
    <field name="name">Tipsoi</field>
    <field name="description">Attendance and device integration with Tipsoi.</field>
    <field name="sequence">20</field>
  </record>

  <!-- Odoo 19 groups hang off a privilege, not the module category directly; the privilege
       is what carries the category. `full_name` renders as "<privilege> / <group>", which is
       why the group names below are bare rather than repeating "Tipsoi". -->
  <record id="privilege_tipsoi" model="res.groups.privilege">
    <field name="name">Tipsoi</field>
    <field name="category_id" ref="module_category_tipsoi"/>
    <field name="sequence">20</field>
  </record>

  <record id="group_tipsoi_user" model="res.groups">
    <field name="name">User</field>
    <field name="privilege_id" ref="privilege_tipsoi"/>
    <field name="comment">Reads punch logs, devices and sync runs, and resolves
      unmatched punches. Cannot see credentials or change the connection.</field>
  </record>

  <record id="group_tipsoi_admin" model="res.groups">
    <field name="name">Administrator</field>
    <field name="privilege_id" ref="privilege_tipsoi"/>
    <field name="implied_ids" eval="[(4, ref('group_tipsoi_user'))]"/>
    <field name="comment">Configures the backend. This is the only group that can read
      the stored credentials and tokens -- the secret fields are restricted to it at the
      field level, not merely hidden in the view.</field>
  </record>

  <!-- Odoo 19 dropped the `base.default_user` template record. New users now get
       `base.group_user` plus whatever `base.default_user_group` implies, so granting a
       group by default means adding it there. -->
  <record id="base.default_user_group" model="res.groups">
    <field name="implied_ids" eval="[(4, ref('group_tipsoi_admin'))]"/>
  </record>

  <!-- One backend per company, and never visible across companies. -->
  <record id="rule_tipsoi_backend_company" model="ir.rule">
    <field name="name">Tipsoi backend: own company only</field>
    <field name="model_id" ref="model_tipsoi_backend"/>
    <field name="domain_force">[('company_id','in',company_ids)]</field>
  </record>

  <record id="rule_tipsoi_sync_run_company" model="ir.rule">
    <field name="name">Tipsoi sync run: own company only</field>
    <field name="model_id" ref="model_tipsoi_sync_run"/>
    <field name="domain_force">[('company_id','in',company_ids)]</field>
  </record>


  <record id="rule_tipsoi_device_company" model="ir.rule">
    <field name="name">Tipsoi device: own company only</field>
    <field name="model_id" ref="model_tipsoi_device"/>
    <field name="domain_force">[('company_id','in',company_ids)]</field>
  </record>

  <record id="rule_tipsoi_punch_log_company" model="ir.rule">
    <field name="name">Tipsoi punch log: own company only</field>
    <field name="model_id" ref="model_tipsoi_punch_log"/>
    <field name="domain_force">[('company_id','in',company_ids)]</field>
  </record>

  <record id="rule_tipsoi_day_attendance_company" model="ir.rule">
    <field name="name">Tipsoi day attendance: own company only</field>
    <field name="model_id" ref="model_tipsoi_day_attendance"/>
    <field name="domain_force">[('company_id','in',company_ids)]</field>
  </record>

</odoo>
